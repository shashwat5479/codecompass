# --- Required on Vercel (Project -> Settings -> Environment Variables) -------------
# Long random string used to sign login tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Postgres connection string. Adding a Neon / Supabase / Vercel Postgres integration injects
# POSTGRES_URL automatically, in which case you can leave DATABASE_URL unset.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Optional -----------------------------------------------------------------------
# Seed demo accounts + jobs into an EMPTY database on first boot ("true" / "false").
# Default: only for the throw-away SQLite demo mode used when no Postgres is configured.
# AUTO_SEED=true

# Comma-separated allowed origins. Not needed when frontend and API share one Vercel domain.
# CORS_ORIGINS=https://your-app.vercel.app

# Resume upload limit in bytes (Vercel rejects request bodies over ~4.5 MB).
# MAX_UPLOAD_SIZE=4194304

# --- Local development ---------------------------------------------------------------
# DATABASE_URL=sqlite:///./careercompass.db
